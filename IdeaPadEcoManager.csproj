<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    
    <AssemblyName>IdeaPadEcoManager</AssemblyName>
    <RootNamespace>IdeaPadEcoManager</RootNamespace>
    <Title>Lenovo IdeaPad Gaming 3 Eco &amp; Performance Manager</Title>
    <Product>IdeaPadEcoManager</Product>
    <Version>1.0.0</Version>
    <Authors>DeepMind / Antigravity</Authors>
    <Description>Automatic power, cooling and GPU management tray application for Lenovo IdeaPad Gaming 3 15IHU6.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
